{
  "inputs": [
    {
      "id": "ado_org",
      "type": "promptString",
      "description": "Azure DevOps organization name (e.g. 'IdentityDivision')",
      "default": "IdentityDivision"
    }
  ],
  "servers": {
    // Shared MCP server configuration for android-complete
    // Docs: https://code.visualstudio.com/docs/copilot/chat/mcp-servers

    "mcp-ado-identitydivision": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${input:ado_org}",
        "-d",
        "core",
        "work",
        "work-items",
        "repositories",
        "pipelines"
      ]
    },

    "workiq": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@microsoft/workiq", "mcp"],
      "tools": ["*"]
    },

    "azure-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@latest", "server", "start"],
      "tools": ["*"]
    },

    "s360-breeze-mcp": {
      "type": "http",
      "url": "https://mcp.vnext.s360.msftcloudes.com/"
    },

    "android-dri-search": {
      "type": "http",
      "url": "https://android-dri-mcp.proudbeach-7e7ce77d.eastus.azurecontainerapps.io/mcp"
    },

    // Agency adapters require the Agency CLI on PATH and per-user service access.
    "es-chat": {
      "type": "stdio",
      "command": "agency",
      "args": ["mcp", "es-chat"]
    },

    "m365-user": {
      "type": "stdio",
      "command": "agency",
      "args": ["mcp", "m365-user"]
    },

    "kusto": {
      "type": "stdio",
      "command": "agency",
      "args": ["mcp", "kusto"]
    },

    "bluebird": {
      "type": "stdio",
      "command": "agency",
      "args": ["mcp", "bluebird", "--organization", "IdentityDivision", "--project", "Engineering"]
    },

    "icm": {
      "type": "stdio",
      "command": "agency",
      "args": ["mcp", "icm"]
    }
  }
}
